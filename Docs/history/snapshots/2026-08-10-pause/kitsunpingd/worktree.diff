+fn adaptive_sampling_command(arguments: &[String]) -> Result<String, String> {
+    let mut values = BTreeMap::new();
+    let mut index = 0;
+    while index < arguments.len() {
+        let key = arguments.get(index).ok_or("missing adaptive argument")?;
+        let value = arguments
+            .get(index + 1)
+            .ok_or_else(|| format!("{key} requires a value"))?;
+        if !key.starts_with("--") {
+            return Err(format!("unknown adaptive argument: {key}"));
+        }
+        values.insert(key.as_str(), value.as_str());
+        index += 2;
+    }
+    let required = |key| values.get(key).copied().ok_or_else(|| format!("{key} requires a value"));
+    let integer = |key| {
+        required(key)?.parse::<u64>().map_err(|_| format!("{key} must be an unsigned integer"))
+    };
+    let optional_integer = |key| match values.get(key).copied() {
+        Some("") | None => Ok(None),
+        Some(value) => value.parse::<u64>().map(Some).map_err(|_| format!("{key} must be an unsigned integer or empty")),
+    };
+    let enabled = match required("--enabled")? {
+        "1" => true,
+        "0" => false,
+        _ => return Err("--enabled must be 0 or 1".into()),
+    };
+    let input = adaptive_sampling::Input {
+        base_interval: integer("--base-interval")?,
+        enabled,
+        mode: required("--mode")?,
+        wifi_iface: required("--wifi-iface")?,
+        wifi_state: required("--wifi-state")?,
+        wifi_quality_reason: required("--wifi-quality-reason")?,
+        wifi_score: optional_integer("--wifi-score")?,
+        wifi_latency_ms: optional_integer("--wifi-latency-ms")?,
+        wifi_jitter_ms: optional_integer("--wifi-jitter-ms")?,
+        wifi_loss_pct: optional_integer("--wifi-loss-pct")?,
+        wifi_loss_trend_pct: required("--wifi-loss-trend-pct")?,
+        wifi_probe_ok: required("--wifi-probe-ok")?,
+        bad_streak: integer("--bad-streak")?,
+        good_streak: integer("--good-streak")?,
+        required_bad_streak: integer("--required-bad-streak")?,
+        required_good_streak: integer("--required-good-streak")?,
+        base_seconds: integer("--base-seconds")?,
+        degraded_seconds: integer("--degraded-seconds")?,
+        wifi_score_threshold: integer("--wifi-score-threshold")?,
+        wifi_latency_threshold_ms: integer("--wifi-latency-threshold-ms")?,
+        wifi_jitter_threshold_ms: integer("--wifi-jitter-threshold-ms")?,
+        wifi_loss_threshold_pct: integer("--wifi-loss-threshold-pct")?,
+    };
+    let output = adaptive_sampling::evaluate(&input);
+    Ok(format!(
+        "interval={}\nmode={}\nreason={}\nbad_streak={}\ngood_streak={}\n",
+        output.interval, output.mode, output.reason, output.bad_streak, output.good_streak
+    ))
+}
